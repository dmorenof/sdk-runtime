{
    "name": "dmorenof/redsys-sdk",
    "description": "Redsys (TPV Virtual) payments for PHP 8.4: signed payment forms and verified notifications, on dmorenof/sdk-runtime.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "ext-openssl": "*",
        "dmorenof/sdk-runtime": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Redsys\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Redsys\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": {
                "symlink": false
            }
        }
    ]
}