{
    "name": "dmorenof/sdk-runtime",
    "description": "Lightweight shared PHP runtime for contract-driven SDKs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "php": "^8.3",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "typedarray/typedarray": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Dmorenof\\SdkRuntime\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dmorenof\\SdkRuntime\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "validate": "@composer validate --strict --no-check-lock"
    },
    "keywords": [
        "sdk",
        "runtime",
        "php",
        "typed-dto",
        "api-client"
    ],
    "homepage": "https://github.com/dmorenof/sdk-runtime",
    "authors": [
        {
            "name": "David Moreno Falero",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/dmorenof/sdk-runtime/issues",
        "source": "https://github.com/dmorenof/sdk-runtime"
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^11.5"
    }
}
